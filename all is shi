class NODE_OT_export_json_ai_schema(bpy.types.Operator):
    bl_idname = "node.export_json_ai_schema"
    bl_label = "Export Node Tree JSON"
    bl_description = "Export current Node Editor's node tree (edit_tree) to JSON"
    bl_options = {'REGISTER'}

    def execute(self, context):
        prefs = context.preferences.addons[__name__].preferences

        node_tree = find_node_editor_tree(context)
        if node_tree is None:
            self.report({'ERROR'}, "No Node Editor node tree found. Open a Node Editor/Shader/Compositor and ensure a tree is visible.")
            return {'CANCELLED'}

        out_dir = resolve_output_dir(prefs.output_dir)
        suffix = prefs.file_suffix.strip()
        fname = f"{node_tree.name}_{suffix}.json" if suffix else f"{node_tree.name}.json"
        out_path = out_dir / fname

        try:
            export_node_tree_to_json(
                node_tree, out_path,
                export_abs_pos=prefs.export_abs_pos,
                export_frames=prefs.export_frames,
                include_socket_name=prefs.include_socket_name,
                include_node_label=prefs.include_node_label,
            )
        except Exception as e:
            self.report({'ERROR'}, f"Export failed: {e}")
            return {'CANCELLED'}

        self.report({'INFO'}, f"Exported: {str(out_path)}")
        return {'FINISHED'}


class NODE_PT_node_json_exporter_panel(bpy.types.Panel):
    bl_label = "Node JSON Export"
