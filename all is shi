def find_node_editor_tree(context):
    """
    从“触发按钮的那个 Node Editor”上，可靠地取到当前可见的 NodeTree。

    ----------------------------
    关键 API / 类型定义（Blender Python RNA）
    ----------------------------

    1) context.area : bpy.types.Area | None
       - 当前 Operator 执行时的“触发区域”（你点按钮所在的区域）
       - 对 Node Editor 来说：context.area.type == 'NODE_EDITOR'
       - 典型坑：你如果在别的区域触发 Operator（比如 3D View 的菜单/快捷键），这里就不是 NODE_EDITOR

    2) context.space_data : bpy.types.Space | None
       - 当前 Operator 执行时的“触发 Space”（area 内当前激活的 space）
       - 当 area.type == 'NODE_EDITOR' 时，space_data 实际类型为：
         bpy.types.SpaceNodeEditor（在 RNA 中也常被称为 SpaceNodeEditor）
       - 关键字段：
         - space.tree_type : str
           * 'ShaderNodeTree' / 'CompositorNodeTree' / 'GeometryNodeTree'
           * 注意：Shader/Compositor/GN 在 Area 层级都同样是 'NODE_EDITOR'，区分只靠 tree_type
         - space.node_tree : bpy.types.NodeTree | None
           * 当前显示的根树（或 pinned 的树）
         - space.edit_tree : bpy.types.NodeTree | None
           * “进入 Group 后”的当前编辑子树（你看到的那一层）
           * 你在节点组内部点 Export 时，必须优先用 edit_tree

    3) bpy.types.NodeTree
       - node_tree.nodes / node_tree.links 就是你要遍历导出的数据

    ----------------------------
    策略说明
    ----------------------------
    - 强绑定：优先只取 context.area + context.space_data 对应的树（也就是“你点击按钮的那个面板”）
    - 不扫屏：默认不扫描 screen.areas（因为那会把别的 Node Editor 的树误当成目标）
    - 若当前 space 没有 tree（None），直接返回 None，让上层报错提示用户：
      “当前 Node Editor 没有可导出的 NodeTree（可能没开 Use Nodes / 没有绑定材质/合成树 / 等）”

    返回：
      bpy.types.NodeTree | None
    """

    # 1) 必须确认本次执行上下文确实来自 Node Editor 区域
    area = getattr(context, "area", None)          # bpy.types.Area | None
    space = getattr(context, "space_data", None)   # bpy.types.SpaceNodeEditor | None

    if area is None or space is None:
        return None

    # Area.type: e.g. 'VIEW_3D', 'NODE_EDITOR', 'IMAGE_EDITOR', ...
    if getattr(area, "type", None) != 'NODE_EDITOR':
        return None

    # 2) 进入 Group 时，edit_tree 才是“当前可见/可编辑”的那一层
    edit_tree = getattr(space, "edit_tree", None)  # bpy.types.NodeTree | None
    if edit_tree is not None:
        return edit_tree

    # 3) 否则回退到 node_tree（根树 / pinned 树）
    node_tree = getattr(space, "node_tree", None)  # bpy.types.NodeTree | None
    if node_tree is not None:
        return node_tree

    # 4) 当前 Node Editor 没有树：不要扫屏找别的 Node Editor（那会导错）
    return None


