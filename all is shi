import bpy
import json
from pathlib import Path
from bpy.props import (
    StringProperty,
    BoolProperty,
)

# ===== params 白名单：只保留高信息密度字段 =====
PARAM_WHITELIST = {
    "operation", "domain", "data_type", "input_type", "transform_space",
    "mode", "interpolation", "clamp", "axis",
    "use_clamp", "space", "coordinate_space",
}

SCHEMA_NAME = "blender-nodes-ai@1"  # 你之前一直沿用这个 schema 名字；材质/合成也可复用


# ===== JSON 兜底：序列化 Blender / mathutils 类型 =====
def to_json_default(obj):
    try:
        if hasattr(obj, "__iter__") and not isinstance(obj, (str, bytes)):
            return [to_json_default(x) for x in list(obj)]
    except Exception:
        pass

    try:
        if hasattr(obj, "name"):
            return obj.name
    except Exception:
        pass

    return str(obj)


def socket_type(s):
    return (
        getattr(s, "bl_socket_idname", None) or
        getattr(s, "bl_idname", None) or
        getattr(s, "type", None) or
        type(s).__name__
    )


def abs_node_pos(n):
    """
    Node Editor 的“绝对位置”：
    node.location 对 parent frame 可能是相对值
    abs = 自己 location + 所有祖先 frame 的 location 累加
    """
    x = float(getattr(n.location, "x", 0.0))
    y = float(getattr(n.location, "y", 0.0))
    p = getattr(n, "parent", None)
    while p is not None:
        try:
            x += float(p.location.x)
            y += float(p.location.y)
        except Exception:
            break
        p = getattr(p, "parent", None)
    return [x, y]


def dump_socket(s, is_input: bool, include_socket_name: bool):
    d = {
        "identifier": getattr(s, "identifier", s.name),
        "socket_type": socket_type(s),
    }
    if include_socket_name:
        d["name"] = s.name

    # default_value：只对输入、且未连接时保留
    if is_input and hasattr(s, "default_value") and not getattr(s, "is_linked", False):
        try:
            d["default_value"] = s.default_value
        except Exception:
            pass

    return d


def dump_node_params(n):
    params = {}
    for key in PARAM_WHITELIST:
        try:
            if hasattr(n, key):
                params[key] = getattr(n, key)
        except Exception:
            pass
    return params


def export_frames_block(node_tree, export_abs_pos: bool):
    frames = [n for n in node_tree.nodes if n.bl_idname == "NodeFrame"]
    if not frames:
        return []

    children_nodes_map = {f: [] for f in frames}
    children_frames_map = {f: [] for f in frames}

    for n in node_tree.nodes:
        p = getattr(n, "parent", None)
        if p is None:
            continue
        if p in children_nodes_map:
            children_nodes_map[p].append(n.name)

    for f in frames:
        pf = getattr(f, "parent", None)
        if pf is not None and getattr(pf, "bl_idname", "") == "NodeFrame":
            if pf in children_frames_map:
                children_frames_map[pf].append(f.name)

    out = []
    for f in frames:
        fd = {
            "name": f.name,
            "label": f.label or "",
            "parent_frame": getattr(getattr(f, "parent", None), "name", None),
            "children_nodes": children_nodes_map.get(f, []),
            "child_frames": children_frames_map.get(f, []),
        }
        if export_abs_pos:
            fd["pos"] = abs_node_pos(f)
        out.append(fd)

    return out


def resolve_output_dir(output_dir: str) -> Path:
    if output_dir:
        try:
            p = Path(output_dir)
            p.mkdir(parents=True, exist_ok=True)
            return p
        except Exception:
            pass
    return Path(bpy.path.abspath("//"))


def find_node_editor_tree(context):
    area = getattr(context, "area", None)
    space = getattr(context, "space_data", None)

    if area is None or space is None:
        return None
    if getattr(area, "type", None) != 'NODE_EDITOR':
        return None

    # 1) 最可靠：path 最后一项就是当前正在编辑/显示的那一层
    path = getattr(space, "path", None)
    if path and len(path) > 0:
        nt = getattr(path[-1], "node_tree", None)
        if nt is not None:
            return nt

    # 2) 回退：edit_tree（某些情况下仍可用）
    edit_tree = getattr(space, "edit_tree", None)
    if edit_tree is not None:
        return edit_tree

    # 3) 再回退：node_tree（根树 / pinned 树）
    node_tree = getattr(space, "node_tree", None)
    if node_tree is not None:
        return node_tree

    return None






def export_node_tree_to_json(node_tree, out_path: Path,
                            export_abs_pos: bool,
                            export_frames: bool,
                            include_socket_name: bool,
                            include_node_label: bool):
    nodes_out = []
    for n in node_tree.nodes:
        nd = {
            "name": n.name,
            "type": n.bl_idname,
            "params": dump_node_params(n),
            "inputs": [dump_socket(s, True, include_socket_name) for s in n.inputs],
            "outputs": [dump_socket(s, False, include_socket_name) for s in n.outputs],
        }
        if include_node_label:
            nd["label"] = n.label or ""
        if export_abs_pos:
            nd["pos"] = abs_node_pos(n)
        nodes_out.append(nd)

    links_out = []
    for l in node_tree.links:
        links_out.append({
            "from_node": l.from_node.name,
            "from_socket": getattr(l.from_socket, "identifier", l.from_socket.name),
            "to_node": l.to_node.name,
            "to_socket": getattr(l.to_socket, "identifier", l.to_socket.name),
        })

    data = {
        "schema": SCHEMA_NAME,
        "node_tree_name": node_tree.name,
        "nodes": nodes_out,
        "links": links_out,
    }

    if export_frames:
        data["frames"] = export_frames_block(node_tree, export_abs_pos)

    out_path.write_text(
        json.dumps(data, ensure_ascii=False, indent=2, default=to_json_default),
        encoding="utf-8"
    )


